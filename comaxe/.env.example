# ═════════════════════════════════════════════════════════════════
# COMAXE — VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en `.env` (racine comaxe/) et renseigner les
# valeurs. Jamais de clé réelle ni d'identifiant codé en dur dans src/.
# ═════════════════════════════════════════════════════════════════

# ── Supabase (requis — application + scripts) ──────────────────────
# Projet Supabase : Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé SERVICE ROLE — SERVEUR UNIQUEMENT (service role, jamais au
# navigateur). Utilisée par src/lib/supabase/server.ts et les tests.
SUPABASE_SERVICE_ROLE_KEY=

# Jeton d'accès Supabase Management API — UNIQUEMENT pour les scripts
# `scripts/apply-*.mjs` (application du SQL en base). À placer dans le
# `.env` à la RACINE du projet (parent de comaxe/), pas ici.
# Token personnalisé : https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ═════════════════════════════════════════════════════════════════
# ABONNEMENT STRIPE (phase 1 : SIMULATEUR)
# Aucune clé n'est requise pour faire tourner l'application ni le
# simulateur d'abonnement. Renseigner ces valeurs UNIQUEMENT pour
# activer le vrai paiement Stripe (mode test du dashboard).
# Jamais de clé réelle ni d'identifiant Price codé en dur dans src/.
# ═════════════════════════════════════════════════════════════════

# Clé PUBLIQUE (frontend, préfixe du dashboard : pk_test_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Clé SECRÈTE — SERVEUR UNIQUEMENT, jamais exposée au navigateur
STRIPE_SECRET_KEY=

# Secret de signature des webhooks (dashboard Stripe / stripe listen)
STRIPE_WEBHOOK_SECRET=
# Identifiants Price des offres payantes (dashboard Stripe).
# UN Price = UN identifiant `price_…` créé pour chaque offre ET chaque
# intervalle → 4 Price IDs au total (Pro/Max × mensuel/annuel).
# L'intervalle est porté par le Price lui-même : ne jamais le deviner.
STRIPE_PRO_PRICE_ID_MONTHLY=
STRIPE_PRO_PRICE_ID_ANNUAL=
STRIPE_MAX_PRICE_ID_MONTHLY=
STRIPE_MAX_PRICE_ID_ANNUAL=
