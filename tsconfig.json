{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "./comaxe",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["comaxe/next-env.d.ts", "comaxe/**/*.ts", "comaxe/**/*.tsx", "comaxe/.next/types/**/*.ts"],
  "exclude": ["comaxe/node_modules"]
}
